# Server-side only — never exposed to the browser.
#
# Two providers are supported and whichever key is set decides which one runs.
# GEMINI_API_KEY wins if both are present. Nothing downstream changes: entries
# are normalised to the same shape before they leave api/expand.ts.
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for word expansion. Defaults to
# gemini-2.5-flash or claude-haiku-5-5 depending on which key is set. Set a
# stronger model here if genders or verb forms come back wrong — it must match
# the provider whose key is configured.
# LINGUA_MODEL=claude-sonnet-5-5

# Supabase — these are build-time and end up in the browser bundle, which is
# fine: the publishable key grants nothing on its own and every table is
# protected by row-level security. Never put the service-role key here.
VITE_SUPABASE_URL=https://vfximbxcxczntqywdryd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
